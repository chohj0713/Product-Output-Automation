{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logic Inventory Data",
  "type": "object",
  "required": ["version", "feature", "prototype", "keywords", "summary", "topCandidateFiles", "items", "domSelectorMappings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "feature": { "type": "string" },
    "prototype": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "summary": {
      "type": "object",
      "required": ["candidateFileCount", "inventoryItemCount", "logicTypes", "categories"],
      "properties": {
        "candidateFileCount": { "type": "number" },
        "inventoryItemCount": { "type": "number" },
        "logicTypes": { "type": "object" },
        "categories": { "type": "object" }
      }
    },
    "topCandidateFiles": { "type": "array" },
    "items": { "type": "array" },
    "domSelectorMappings": { "type": "array" }
  }
}
