{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Spec Coverage Summary",
  "type": "object",
  "required": ["feature", "statusSummary", "logicTypeSummary"],
  "properties": {
    "feature": { "type": "string" },
    "statusSummary": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "logicTypeSummary": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    }
  }
}
