{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preprocessed Code Summary",
  "type": "object",
  "required": ["version", "generatedAt", "keywords", "domNodes", "eventListeners", "selectorMappings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "domNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["selector", "tag", "source"],
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "tag": { "type": "string" },
          "id": { "type": "string" },
          "className": { "type": "string" },
          "dataAttributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "source": { "type": "string" },
          "textHint": { "type": "string" }
        }
      }
    },
    "eventListeners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "source"],
        "properties": {
          "event": { "type": "string" },
          "selector": { "type": "string" },
          "handler": { "type": "string" },
          "source": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "selectorMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["selector", "sources", "operations", "summaries"],
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "type": "string" } },
          "operations": { "type": "array", "items": { "type": "string" } },
          "summaries": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
