{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Figma Card Data",
  "type": "object",
  "required": ["version", "template", "feature", "project", "generatedFrom", "cards"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "template": {
      "type": "object",
      "required": ["source", "fileKey", "nodeId", "width", "titleHeight", "accent", "policyAccent"],
      "properties": {
        "source": { "const": "canonical-figma-node" },
        "fileKey": { "const": "MGMCrXQxxIvOkCAAw3bxCq" },
        "nodeId": { "const": "77:501" },
        "width": { "const": 840 },
        "titleHeight": { "const": 120 },
        "accent": { "type": "string" },
        "policyAccent": { "type": "string" }
      }
    },
    "feature": { "type": "string", "minLength": 1 },
    "project": { "type": "string" },
    "generatedFrom": { "type": "string" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "frameName", "situation", "screenName", "screenPath", "caseName", "blocks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "frameName": { "type": "string" },
          "situation": { "type": "string" },
          "screenName": { "type": "string" },
          "screenPath": { "type": "string" },
          "caseName": { "type": "string" },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["number", "kind", "title", "bullets"],
              "additionalProperties": false,
              "properties": {
                "number": { "type": "string" },
                "kind": { "enum": ["policy", "item"] },
                "title": { "type": "string" },
                "bullets": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
